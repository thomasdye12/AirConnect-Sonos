new file mode 100644
--- /dev/null
+++ b/src/raop_metadata_util.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+
+/* ICY has a one-byte length in units of 16 bytes. Keep fields bounded and
+ * prevent quotes/control characters from terminating its quoted values. */
+#define RAOP_ICY_MAX (255 * 16 + 1)
+static inline void raop_icy_text(char *out, size_t size, const char *in) {
+    size_t n = in ? strlen(in) : 0;
+    if (n >= size) {
+        n = size - 1;
+        while (n && ((unsigned char)in[n] & 0xc0) == 0x80) n--;
+    }
+    for (size_t i = 0; i < n; i++) {
+        unsigned char c = in[i];
+        out[i] = (c < 32 || c == 127) ? ' ' : c == '\'' ? '`' : c == '\\' ? '/' : c;
+    }
+    out[n] = 0;
+}
+
+static inline size_t raop_icy_packet(uint8_t out[RAOP_ICY_MAX], const char *artist,
+                                    const char *title, const char *artwork) {
+    char a[1024], t[1024], u[1024];
+    raop_icy_text(a, sizeof(a), artist);
+    raop_icy_text(t, sizeof(t), title);
+    raop_icy_text(u, sizeof(u), artwork);
+    memset(out, 0, RAOP_ICY_MAX);
+    int n = snprintf((char*)out + 1, RAOP_ICY_MAX - 1, "StreamTitle='%s%s%s';%s%s%s",
+        a, *a && *t ? " - " : "", t, *u ? "StreamURL='" : "", u, *u ? "';" : "");
+    out[0] = (n + 15) / 16;
+    return 1 + out[0] * 16;
+}
+
+static inline const char *raop_image_type(const char *type, const void *data, size_t len) {
+    const unsigned char *p = data;
+    if (!type || !p || len > 4 * 1024 * 1024) return NULL;
+    if (!strcmp(type, "image/jpeg") && len >= 3 && p[0] == 0xff && p[1] == 0xd8 && p[2] == 0xff) return "jpg";
+    if (!strcmp(type, "image/png") && len >= 8 && !memcmp(p, "\x89PNG\r\n\x1a\n", 8)) return "png";
+    return NULL;
+}
