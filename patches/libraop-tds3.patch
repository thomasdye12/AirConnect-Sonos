+/* Optional ordered PCM output. All callbacks run on the output thread, outside
+ * the packet-ingest lock. close follows the final write, including on failure.
+ * An open failure stops this output; it never falls back to HTTP silently. */
+typedef struct {
+    void *owner;
+    void *(*open)(void *owner, const volatile bool *running);
+    int (*write)(void *session, const uint8_t *pcm, size_t bytes);
+    void (*close)(void *session);
+    unsigned int lead_ms; /* Sink presentation lead; submit this early. */
+    int sync_offset_ms; /* Local calibration; positive delays audio. */
+} raop_pcm_output_t;
+
